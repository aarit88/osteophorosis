{
  "name": "osteophorosis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false,
    "skipTraversal": true
  },
  "scripts": {
    "dev": "tsx server.ts",
    "mock": "node mock-server/index.js",
    "dev:full": "concurrently \"npm run mock\" \"vite --host 0.0.0.0 --port 3000\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "openapi:validate": "redocly lint openapi.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "echo 'Playwright test runner configured: npx playwright test'"
  },
  "dependencies": {
    "@redocly/cli": "^2.75.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.9.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.7.2",
    "jsdom": "^31.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
