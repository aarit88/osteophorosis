FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 osteoguard \
    && useradd --system --uid 10001 --gid osteoguard --create-home --home-dir /home/osteoguard osteoguard

WORKDIR /app
COPY ml_service/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN python -m pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
      torch==2.9.0 torchvision==0.24.0 \
    && python -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt

COPY --chown=osteoguard:osteoguard ml_service ./ml_service
COPY --chown=osteoguard:osteoguard osteoguard ./osteoguard
COPY --chown=osteoguard:osteoguard ml_artifacts ./ml_artifacts
RUN mkdir -p /var/lib/osteoguard/artifacts /var/lib/osteoguard/ledger /var/lib/osteoguard/onboarding /run/osteoguard \
    && chown -R osteoguard:osteoguard /var/lib/osteoguard /run/osteoguard

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" || exit 1

CMD ["python", "-m", "uvicorn", "ml_service.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
