# Local Compose defaults only. Copy to .env and replace blank secrets where required.
NODE_ENV=development
OSTEO_ENV=development
HOST=0.0.0.0
PORT=3000
HOST_PORT=3000
BACKEND_URL=http://ml-service:8000
OSTEO_LOG_LEVEL=INFO
OSTEO_CORS_ORIGINS=http://localhost:3000

# Generate each secret locally/outside source control. Production requires all values.
OSTEO_CLINICAL_API_TOKEN=
OSTEO_GATEWAY_HMAC_SECRET=
OSTEO_AUDIT_ENCRYPTION_KEY=
OSTEO_AUDIT_LEDGER_HMAC_KEY=
OSTEO_ONBOARDING_LEDGER_HMAC_KEY=
OSTEO_PREPARATION_HMAC_KEY=
OSTEO_SOURCE_QUALIFICATION_HMAC_KEY=

# Optional institution-provisioned reviewer registry; mount the configured file read-only.
OSTEO_REVIEWER_AUTHORIZATION_FILE=
OSTEO_REVIEWER_REGISTRY_HOST_PATH=
OSTEO_ADJUDICATION_LEDGER_FILE=/var/lib/osteoguard/ledger/adjudication.jsonl
OSTEO_ONBOARDING_REGISTRY_FILE=/var/lib/osteoguard/onboarding/registry.json
OSTEO_ONBOARDING_ROOT=/var/lib/osteoguard/onboarding/packages
OSTEO_STAGING_ROOT=/var/lib/osteoguard/onboarding/staged
OSTEO_PREPARATION_REGISTRY_FILE=/var/lib/osteoguard/onboarding/preparation/registry.json
OSTEO_PREPARATION_ROOT=/var/lib/osteoguard/onboarding/preparation/runs
OSTEO_SOURCE_QUALIFICATION_FILE=/var/lib/osteoguard/onboarding/qualification/registry.json
OSTEO_DISABLE_DEMO_SEED=true
OSTEO_STRICT_CLINICAL_MODE=true

# Compose paths. Dataset source is read-only; checkpoints are not included in images.
OSTEO_BASE_DIR=/app
OSTEO_DATA_DIR=/data
OSTEO_RAW_DATA_DIR=/data/raw
OSTEO_INTERIM_DATA_DIR=/data/interim
OSTEO_PROCESSED_DATA_DIR=/data/processed
OSTEO_SPLITS_DATA_DIR=/data/splits
OSTEO_ARTIFACTS_DIR=/var/lib/osteoguard/artifacts
OSTEO_CHECKPOINTS_DIR=/var/lib/osteoguard/artifacts/checkpoints
OSTEO_METRICS_DIR=/var/lib/osteoguard/artifacts/metrics
OSTEO_LOGS_DIR=/var/lib/osteoguard/artifacts/logs
OSTEO_STAGE_REPORTS_DIR=/var/lib/osteoguard/artifacts/stage_reports
OSTEO_ACTIVE_BACKBONE=resnet101
OSTEO_DEVICE=cpu
# Optional only after authorized genuine model release; never point to Track C.
# OSTEO_ACTIVE_CHECKPOINT_PATH=/var/lib/osteoguard/artifacts/checkpoints/track-d-release.pt
# OSTEO_TRACK_D_CHECKPOINT_SHA256=<externally-verified-sha256>

# Existing preliminary Track A FracAtlas X-ray model (separate from Track D).
# Mount the genuine, locally held checkpoint under OSTEO_ARTIFACTS_DIR; never commit weights.
# OSTEO_TRACK_A_CHECKPOINT_PATH=/var/lib/osteoguard/artifacts/fracatlas_full_training/best_checkpoint.pt

# Browser requests use the same-origin Express gateway by default.
VITE_API_BASE_URL=
VITE_ENGINE=auto
