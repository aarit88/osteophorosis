# ==============================================================================
# OsteoGuard AI - Environment Configuration Reference
# ==============================================================================

# VITE_API_BASE_URL:
# Base URL for the mock API server or current deployed backend.
# - Standalone mock-server: http://localhost:8787
# - Unified dev server (port 3000): leave blank or set to http://localhost:3000
# - In production / container: relative URL or full origin
VITE_API_BASE_URL=http://localhost:8787

# VITE_API_BASE_URL_LIVE:
# Endpoint URL for Teammate B's real PyTorch/FastAPI backend once available.
# When VITE_ENGINE is set to "live" or "auto", requests route here.
# Example: https://api.osteoguard-internal.hospital.org
VITE_API_BASE_URL_LIVE=

# VITE_ENGINE:
# Active inference engine selection strategy.
# Options:
#   "mock"     -> Always use local mock simulation engine
#   "live"     -> Always use Teammate's live PyTorch backend (throws if offline or not configured)
#   "auto"     -> Attempts live backend; seamlessly falls back to mock engine with visible UI status badge
VITE_ENGINE=auto

# VITE_USE_ASYNC:
# Enables asynchronous job queue simulation pattern (POST -> 202 Accepted {jobId} -> polling).
# Set to "true" to demo asynchronous background task orchestration.
VITE_USE_ASYNC=false

# VITE_TIMEOUT_MS:
# Network timeout threshold in milliseconds for inference and feedback requests.
# Default: 10000 (10 seconds)
VITE_TIMEOUT_MS=10000

# VITE_MAX_RETRIES:
# Number of retry attempts with exponential backoff on transient network failures.
# Default: 2
VITE_MAX_RETRIES=2
