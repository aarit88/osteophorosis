# ==============================================================================
# OsteoGuard AI - Environment Configuration (.env.example)
# Copy to .env and adjust values for local development or production.
# ==============================================================================

# Service Configuration
OSTEO_SERVICE_NAME="OsteoGuard AI ML Service"
OSTEO_SERVICE_VERSION="1.0.0"
OSTEO_ENV="development"
OSTEO_HOST="0.0.0.0"
OSTEO_PORT=8000
OSTEO_LOG_LEVEL="INFO"

# File System Paths
OSTEO_DATA_DIR="ml_service/data"
OSTEO_RAW_DATA_DIR="ml_service/data/raw"
OSTEO_PROCESSED_DATA_DIR="ml_service/data/processed"
OSTEO_SPLITS_DATA_DIR="ml_service/data/splits"
OSTEO_ARTIFACTS_DIR="ml_artifacts"
OSTEO_CHECKPOINTS_DIR="ml_artifacts/checkpoints"
OSTEO_METRICS_DIR="ml_artifacts/metrics"
OSTEO_LOGS_DIR="ml_artifacts/logs"
OSTEO_STAGE_REPORTS_DIR="ml_artifacts/stage_reports"

# Model Architecture & Device
OSTEO_ACTIVE_BACKBONE="resnet101"
OSTEO_DEVICE="cpu"
OSTEO_FUSION_DIM=614
OSTEO_RADIOMICS_DIM=102
OSTEO_SEMANTIC_DIM=512
OSTEO_NUM_CLASSES=4
OSTEO_MIN_PATIENTS_PER_CLASS=10

# Security & CORS
OSTEO_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "*"]

# Operational Flags
OSTEO_ENABLE_MOCK_FALLBACK=false
